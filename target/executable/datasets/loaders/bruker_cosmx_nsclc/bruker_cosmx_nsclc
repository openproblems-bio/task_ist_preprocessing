    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    kept = skipped = 0
    kept_bytes = 0
    with _open_source(input_targz) as fh, tarfile.open(fileobj=fh, mode="r|gz") as tar:
